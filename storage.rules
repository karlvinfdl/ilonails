rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {

    // Photos d'inspiration jointes à une demande de rendez-vous.
    // Écriture : autorisée à tout visiteur authentifié (auth anonyme
    // incluse), limitée aux images de moins de 5 Mo.
    // Lecture : réservée à l'admin (même logique que Firestore) — la
    // photo d'une cliente n'est jamais publique.
    match /inspirations/{fileName} {
      allow read: if request.auth != null &&
        firestore.exists(/databases/(default)/documents/admins/$(request.auth.uid));
      allow write: if request.auth != null &&
        request.resource.size < 5 * 1024 * 1024 &&
        request.resource.contentType.matches('image/.*');
      allow delete: if request.auth != null &&
        firestore.exists(/databases/(default)/documents/admins/$(request.auth.uid));
    }

    // Deny-by-default.
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
